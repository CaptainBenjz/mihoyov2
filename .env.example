# --- Telegram ---
# Get this from @BotFather. Required to run the bot.
# NOTE: the app loads .env (not this file) at runtime; this value is kept here for
# reference in this private repo. Copy this file to .env to run.
BOT_TOKEN=

# --- Redis (primary datastore) ---
# Required. Upstash connection URL. A redis:// Upstash URL is auto-upgraded to TLS.
#   REDIS_URL=redis://default:<password>@<host>.upstash.io:6379
REDIS_URL=

# --- Localization ---
DEFAULT_LANGUAGE=en

# --- Caching (seconds) ---
# How long to cache Enka showcase responses and Akasha ranking responses.
ENKA_CACHE_TTL=300
AKASHA_CACHE_TTL=600

# --- Assets ---
# Root directory for artwork/icons/frames. Loaded dynamically at runtime.
ASSETS_DIR=assets

# --- Logging ---
LOG_LEVEL=INFO

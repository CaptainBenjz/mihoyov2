# --- Telegram ---
# Get this from @BotFather. Required to run the bot.
BOT_TOKEN=

# --- Database ---
# Async SQLAlchemy URL. Default is a local SQLite file.
# Swap to Postgres later without code changes, e.g.:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/genshinbot
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# --- Localization ---
DEFAULT_LANGUAGE=en

# --- Caching (seconds) ---
# How long to cache Enka showcase responses and Akasha ranking responses.
ENKA_CACHE_TTL=300
AKASHA_CACHE_TTL=600

# --- Assets ---
# Root directory for artwork/icons/frames. Loaded dynamically at runtime.
ASSETS_DIR=assets

# --- Logging ---
LOG_LEVEL=INFO
